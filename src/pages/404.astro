---
import "@fontsource/jost/300.css";
import "@fontsource/jost/400.css";
import "@fontsource/cormorant-garamond/700.css";
import "@/styles/global.css";
import { Image } from "astro:assets";
import LogoFoundation from "@/assets/logos/logo-fundacion.svg";
import { ui, withBase } from "@/i18n/ui";

const langs = ["es", "en", "pt"] as const;
const base = withBase("");
---

<!doctype html>
<html lang="es" id="html-root">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <title>404 — Fundación Vereda Clara</title>
        <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    </head>
    <body data-base={base} class="min-h-screen bg-(--bg-tertiary) flex flex-col items-center justify-center px-4 py-16">
        {
            langs.map((lang) => (
                <div id={`content-${lang}`} class="hidden flex-col items-center text-center gap-6 max-w-sm w-full">
                    <Image src={LogoFoundation} alt={ui[lang].a11y.logoFoundationAlt} class="w-52 mx-auto" />
                    <div class="text-8xl tracking-widest text-(--bg-primary)" style="font-family: var(--font-display); font-weight: 700;">
                        404
                    </div>
                    <h1 class="text-sm tracking-widest uppercase text-(--color-primary)">{ui[lang].notFound.title}</h1>
                    <p class="text-sm text-(--color-primary) opacity-70 leading-relaxed">{ui[lang].notFound.message}</p>
                    <a href={withBase(`${lang}/`)} class="bg-(--bg-primary) text-white text-xs tracking-wider px-8 py-3 hover:opacity-90 transition-opacity">
                        {ui[lang].notFound.button}
                    </a>
                </div>
            ))
        }
        <script is:inline>
            const base = document.body.dataset.base ?? "/";
            const path = window.location.pathname.slice(base.length - 1);
            const lang = path.startsWith("/en") ? "en" : path.startsWith("/pt") ? "pt" : "es";
            document.getElementById("html-root")?.setAttribute("lang", lang);
            const el = document.getElementById(`content-${lang}`);
            if (el) {
                el.classList.remove("hidden");
                el.classList.add("flex");
            }
        </script>
    </body>
</html>
<style>
    a {
        text-decoration: none;
        border-radius: 8px;
    }
</style>
