---
import type { AboutTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";
import aboutBgImage from "@/assets/img/S-Plasta.svg";
import illustrationImage from "@/assets/img/S-Ilustracion.svg";

interface Props {
    texts: AboutTexts;
    a11yTexts: A11yTexts;
}

const { texts, a11yTexts } = Astro.props as Props;
---

<section id="sobre" class="py-12 text-center scroll-mt-14">
    <div class="w-full mx-auto flex flex-col lg:flex-row gap-6 relative px-8 justify-center items-center md:items-baseline">
        <div class="w-full sm:w-[90vw] lg:w-105 lg:shrink-0 flex flex-col items-start grow-[0.2] justify-between lg:gap-80">
            <h2 class="text-3xl font-bold mb-6 uppercase">{texts.title}</h2>
            <Image src={illustrationImage} alt={a11yTexts.aboutIllustrationAlt} class="w-full sm:w-[50%] lg:w-full h-auto self-end" />
        </div>
        <div class="flex-1 flex flex-col gap-6 text-left text-pretty min-w-0 md:min-w-112.5 max-w-180">
            <div class="p-8 md:p-12 about-bg">
                <h3 class="text-xl md:text-3xl font-medium mb-4 uppercase wrap-break-word" set:html={texts.encounter.title} />
                {texts.encounter.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
            </div>
            <div>
                <h3 class="text-xl md:text-3xl font-bold mb-4 uppercase">{texts.foundation.title}</h3>
                <p class="relative pl-10 foundation-content" set:html={texts.foundation.description} />
            </div>
        </div>
    </div>
</section>

<style define:vars={{ bgUrl: `url(${aboutBgImage.src})` }}>
    .about-bg {
        background-image: var(--bgUrl);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        padding-inline: 4rem;
        padding-block: 4rem;

        @media (width <= 400px) {
            border-radius: 1rem;
            padding-inline: 2rem;
            padding-block: 3rem;
        }
    }

    .foundation-content {
        font-family: var(--font-body);

        &::before {
            content: "•";
            position: absolute;
            left: 0;
            top: -46px;
            font-size: 5rem;
            color: var(--bg-red2);
        }
    }
</style>
