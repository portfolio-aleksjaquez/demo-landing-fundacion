---
import type { AboutTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";
import crossingPaths from "@/assets/img/caminos-cruzados.svg";
import LogoFoundation from "@/assets/logos/logo-fundacion.svg";

interface Props {
    texts: AboutTexts;
    a11yTexts: A11yTexts;
}

const { texts, a11yTexts } = Astro.props as Props;
const [lead, ...rest] = texts.encounter.paragraphs;
---

<section id="sobre" class="about" data-trail-stop>
    <div class="wrap about__grid">
        <div class="about__aside">
            <h2 class="section-title">{texts.title}</h2>
            <Image src={crossingPaths} alt={a11yTexts.aboutIllustrationAlt} class="about__art" />
        </div>

        <div class="about__body">
            <h3 class="about__subtitle">{texts.encounter.title}</h3>
            <p class="about__lead">{lead}</p>
            {rest.map((paragraph) => <p class="about__text">{paragraph}</p>)}

            <dl class="about__facts">
                {
                    texts.facts.map((fact) => (
                        <div class="about__fact">
                            <dt>{fact.label}</dt>
                            <dd>{fact.value}</dd>
                        </div>
                    ))
                }
            </dl>

            <div class="host">
                <h3 class="host__title">{texts.foundation.title}</h3>
                <Image src={LogoFoundation} alt={a11yTexts.logoFoundationAlt} class="host__logo" />
                <p class="host__text" set:html={texts.foundation.description} />
            </div>
        </div>
    </div>
</section>

<style>
    .about {
        padding-block: var(--section-space);
    }

    .about__grid {
        display: grid;
        gap: 2.5rem 5rem;
    }

    .about__aside {
        display: grid;
        align-content: start;
        gap: 2.5rem;
    }

    .about__art {
        width: min(100%, 22rem);
        height: auto;
    }

    .about__subtitle {
        font-size: clamp(1.45rem, 2.4vw, 2rem);
        font-weight: 800;
        color: var(--anil);
        max-width: 24ch;
    }

    .about__lead {
        margin-top: 1.25rem;
        font-size: clamp(1.2rem, 1.8vw, 1.45rem);
        line-height: 1.5;
        max-width: 40ch;
    }

    .about__text {
        margin-top: 1rem;
        font-size: 1.06rem;
        max-width: 62ch;
    }

    .about__facts {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2.75rem;
        margin-top: 2.5rem;
        padding-block: 1.25rem;
        border-block: 2px solid var(--anil-ink);
    }

    .about__fact {
        display: flex;
        flex-direction: column-reverse;
    }

    .about__fact dd {
        margin: 0;
        font-size: 2.6rem;
        font-weight: 850;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--anil);
    }

    .about__fact dt {
        font-weight: 600;
    }

    .host {
        display: grid;
        gap: 0.75rem 2rem;
        margin-top: 3rem;
        padding: clamp(1.5rem, 3vw, 2.25rem);
        background-color: var(--jacaranda-soft);
        border-left: 6px solid var(--cempasuchil);
    }

    .host__title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--cempasuchil-ink);
        letter-spacing: 0;
    }

    .host__logo {
        width: 11rem;
        height: auto;
    }

    .host__text {
        font-size: 1.02rem;
    }

    @media (min-width: 1024px) {
        .about__grid {
            grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }

        .about__aside {
            position: sticky;
            top: 7rem;
            align-self: start;
        }

        .host {
            grid-template-columns: 11rem minmax(0, 1fr);
        }

        .host__title {
            grid-column: 1 / -1;
        }
    }

    @media (max-width: 1023px) {
        .about__aside {
            grid-template-columns: minmax(0, 1fr) 7.5rem;
            align-items: end;
        }

        .about__art {
            width: 7.5rem;
        }
    }
</style>
