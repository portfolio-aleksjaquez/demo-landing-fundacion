---
import type { AgendaTexts, A11yTexts } from "@/i18n/ui";

interface Props {
    texts: AgendaTexts;
    a11yTexts: A11yTexts;
}

const { texts } = Astro.props as Props;

// Íconos de cada jornada (trazo propio, heredan el color del texto).
const icons: Record<string, string> = {
    roots: '<path d="M24 6v18M24 24c0 8-8 9-12 16M24 24c0 8 8 9 12 16M24 28v14M16 14h16" />',
    paths: '<path d="M8 40c10 0 22-32 32-32M8 8c10 0 22 32 32 32" />',
    horizon: '<path d="M6 32h36M14 32a10 10 0 0 1 20 0M24 10v6M10.5 17.5l4 4M37.5 17.5l-4 4M6 40h36" />',
};
---

<section id="agenda" class="agenda" data-trail-stop>
    <div class="wrap">
        <header class="agenda__head">
            <h2 class="section-title">{texts.title}</h2>
            <p class="agenda__intro">{texts.intro}</p>
        </header>

        <div class="day-tabs" role="tablist" aria-label={texts.labels.days}>
            {
                texts.activities.map((day, i) => (
                    <button
                        type="button"
                        class="day-tab"
                        role="tab"
                        id={`agenda-tab-${i}`}
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`agenda-panel-${i}`}
                        tabindex={i === 0 ? 0 : -1}
                    >
                        <svg class="day-tab__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false" set:html={icons[day.icon]} />
                        <span class="day-tab__date">
                            {day.weekday} {day.date}
                        </span>
                        <span class="day-tab__title">{day.title}</span>
                    </button>
                ))
            }
        </div>

        {
            texts.activities.map((day, i) => (
                <div class="day-panel" role="tabpanel" id={`agenda-panel-${i}`} aria-labelledby={`agenda-tab-${i}`} tabindex="0" hidden={i !== 0}>
                    <div class="day-panel__focus">
                        <h3 class="day-panel__title">{day.title}</h3>
                        <p class="day-panel__label">{texts.labels.focus}</p>
                        <p class="day-panel__objective">{day.objective}</p>
                    </div>
                    <ol class="timeline">
                        {day.events.map((event) => (
                            <li class="timeline__item">
                                <span class="timeline__time">{event.time}</span>
                                <span class="timeline__node" aria-hidden="true" />
                                <span class="timeline__title">{event.title}</span>
                            </li>
                        ))}
                    </ol>
                </div>
            ))
        }
    </div>
</section>

<style>
    .agenda {
        padding-block: var(--section-space);
    }

    .agenda__head {
        display: grid;
        gap: 1rem 3rem;
        align-items: end;
        margin-bottom: clamp(2rem, 4vw, 3.25rem);
    }

    .agenda__intro {
        max-width: 38ch;
        font-size: 1.1rem;
    }

    .day-tabs {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 0.5rem;
    }

    .day-tab {
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-areas:
            "icon date"
            "icon title";
        column-gap: 0.9rem;
        align-items: center;
        padding: 1rem 1.15rem;
        text-align: left;
        color: var(--anil-ink);
        background-color: var(--jacaranda-soft);
        border-top: 5px solid transparent;
        cursor: pointer;
        transition: background-color 0.2s ease;

        &:hover {
            background-color: var(--jacaranda);
        }

        &[aria-selected="true"] {
            background-color: var(--anil);
            color: var(--cal);
            border-top-color: var(--cempasuchil);
        }
    }

    .day-tab__icon {
        grid-area: icon;
        width: 2.6rem;
        height: 2.6rem;
        fill: none;
        stroke: currentColor;
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .day-tab__date {
        grid-area: date;
        font-size: 0.92rem;
        font-weight: 600;
        opacity: 0.85;
    }

    .day-tab__title {
        grid-area: title;
        font-size: clamp(1.15rem, 2.2vw, 1.6rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }

    .day-panel {
        display: grid;
        gap: 2rem 4rem;
        padding-top: clamp(2rem, 4vw, 3.5rem);

        &[hidden] {
            display: none;
        }

        &:focus-visible {
            outline-offset: 8px;
        }
    }

    .day-panel__title {
        font-size: clamp(2rem, 4vw, 3.25rem);
        color: var(--anil);
    }

    .day-panel__label {
        margin-top: 1.25rem;
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--cempasuchil-ink);
    }

    .day-panel__objective {
        margin-top: 0.35rem;
        font-size: 1.2rem;
        max-width: 34ch;
    }

    .timeline {
        position: relative;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .timeline__item {
        display: grid;
        grid-template-columns: 7.25rem 1.5rem minmax(0, 1fr);
        align-items: baseline;
        gap: 0.75rem;
        position: relative;
        padding-block: 0.85rem;
        border-bottom: 1px solid var(--line);

        &:last-child {
            border-bottom: none;
        }
    }

    .timeline::before {
        content: "";
        position: absolute;
        top: 1.35rem;
        bottom: 1.35rem;
        left: calc(7.25rem + 0.75rem + 0.75rem - 1px);
        width: 2px;
        background-color: var(--jacaranda);
    }

    .timeline__time {
        font-weight: 750;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--anil);
    }

    .timeline__node {
        position: relative;
        justify-self: center;
        width: 0.9rem;
        height: 0.9rem;
        border-radius: 50%;
        background-color: var(--cal);
        border: 3px solid var(--cempasuchil);
        transform: translateY(0.1rem);
    }

    .timeline__title {
        font-size: 1.08rem;
        line-height: 1.45;
    }

    @media (min-width: 900px) {
        .agenda__head {
            grid-template-columns: auto 1fr;
        }

        .agenda__intro {
            justify-self: end;
            text-align: right;
        }

        .day-panel {
            grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
        }

    }

    @media (max-width: 640px) {
        .day-tabs {
            grid-template-columns: 1fr;
            gap: 0.35rem;
        }

        .day-tab {
            grid-template-columns: auto auto 1fr;
            grid-template-areas: "icon title date";
            column-gap: 0.75rem;
            padding: 0.7rem 0.9rem;
            border-top-width: 0;
            border-left: 5px solid transparent;

            &[aria-selected="true"] {
                border-left-color: var(--cempasuchil);
            }
        }

        .day-tab__icon {
            width: 1.9rem;
            height: 1.9rem;
        }

        .day-tab__date {
            justify-self: end;
            font-size: 0.88rem;
        }

        .day-tab__title {
            font-size: 1.2rem;
        }

        .timeline__item {
            grid-template-columns: 1.25rem minmax(0, 1fr);
            grid-template-areas:
                "node time"
                ". title";
            row-gap: 0.15rem;
        }

        .timeline::before {
            left: calc(0.625rem - 1px);
        }

        .timeline__time {
            grid-area: time;
        }

        .timeline__node {
            grid-area: node;
        }

        .timeline__title {
            grid-area: title;
        }
    }
</style>

<script>
    const initAgenda = () => {
        const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("#agenda .day-tab"));
        const panels = Array.from(document.querySelectorAll<HTMLElement>("#agenda .day-panel"));
        if (!tabs.length) return;

        const select = (index: number, focus = false) => {
            tabs.forEach((tab, i) => {
                const active = i === index;
                tab.setAttribute("aria-selected", String(active));
                tab.tabIndex = active ? 0 : -1;
                panels[i].hidden = !active;
            });
            if (focus) tabs[index].focus();
            window.dispatchEvent(new Event("trail:refresh"));
        };

        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => select(i));
            tab.addEventListener("keydown", (e: KeyboardEvent) => {
                const last = tabs.length - 1;
                const keys: Record<string, number> = {
                    ArrowRight: i === last ? 0 : i + 1,
                    ArrowLeft: i === 0 ? last : i - 1,
                    Home: 0,
                    End: last,
                };
                if (e.key in keys) {
                    e.preventDefault();
                    select(keys[e.key], true);
                }
            });
        });
    };

    document.addEventListener("astro:page-load", initAgenda);
</script>
