---
import type { HeroTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";
import heroImage from "@/assets/img/hero-image.svg";
import LogoFoundation from "@/assets/logos/logo-fundacion.svg";
import LogoEvent from "@/assets/logos/logo-encuentro.svg";

interface Props {
    texts: HeroTexts;
    a11yTexts: A11yTexts;
}

const { texts, a11yTexts } = Astro.props as Props;
---

<section class="min-h-100 py-0 lg:py-0 mx-auto text-center relative">
    <div class="lg:absolute top-0 left-0 right-0 flex flex-col items-center justify-center px-6 text-center">
        <div class="max-w-2xl">
            <h1 class="relative whitespace-pre-line font-semibold text-xl sm:text-3xl leading-snug mt-8 text-(--color-primary)/90 hero-subtitle">
                {texts.subtitle}
            </h1>
            <div class="logos flex items-center justify-center gap-4 mt-8">
                <Image src={LogoFoundation} alt={a11yTexts.logoFoundationAlt} class="w-[50%] sm:w-72" />
                <Image src={LogoEvent} alt={a11yTexts.logoEventAlt} class="w-[42%] sm:w-56" />
            </div>
        </div>
    </div>
    <Image src={heroImage} alt={a11yTexts.heroImageAlt} class="mx-auto w-full h-auto block object-contain" />
</section>

<style>
    .hero-subtitle::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 6px;
        background: linear-gradient(90deg, transparent, var(--bg-primary), transparent);
        bottom: -15px;
        left: 0;
    }
</style>
