---
import type { SoonTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";
import landscapeImage from "@/assets/img/Footer-paisaje.svg";

interface Props {
    texts: SoonTexts;
    a11yTexts: A11yTexts;
}

const { texts, a11yTexts } = Astro.props as Props;
---

<section id="soon" class="bg-(--bg-tertiary) relative h-80">
    <div class="container mx-auto px-4 h-full max-w-5xl">
        <h2 class="text-2xl font-bold uppercase">{texts.title}</h2>
        <p class="max-w-[50ch]">{texts.description}</p>
        <ul class="">
            {texts.eventList.map((event) => <li class="relative pl-6">{event}</li>)}
        </ul>
    </div>
    <Image src={landscapeImage} alt={a11yTexts.postEventLandscapeAlt} class="w-96 h-auto soon-img ri" />
</section>

<style>
    li {
        font-family: var(--font-body);
        list-style: none;

        &::before {
            content: "";
            position: absolute;
            left: 0.25rem;
            top: 0.5em;
            width: 0.5rem;
            height: 0.5rem;
            border-radius: 50%;
            background-color: var(--bg-red2);
        }
    }

    #soon {
        display: flex;
        align-items: center;
        height: 20rem;

        @media (width <= 980px) {
            height: auto;
        }

        @media (width <= 660px) {
            flex-direction: column;
        }
    }

    .soon-img {
        position: absolute;
        top: 0;
        right: 2.5rem;

        @media (width <= 980px) {
            position: relative;
        }

        @media (width <= 660px) {
            right: 0;
        }
    }
</style>
