---
import { withBase, type NavTexts, type A11yTexts, type LanguageKeys } from "@/i18n/ui";

interface Props {
    texts: NavTexts;
    a11yTexts: A11yTexts;
    lang: LanguageKeys;
}

const { texts, a11yTexts, lang } = Astro.props as Props;

const links = [
    { href: "#agenda", label: texts.agenda },
    { href: "#sede", label: texts.countdown },
    { href: "#sobre", label: texts.about },
    { href: "#organizaciones", label: texts.organizations },
    { href: "#faq", label: texts.faq },
];

const langs: { code: LanguageKeys; label: string; aria: string }[] = [
    { code: "es", label: "ES", aria: a11yTexts.switchToEs },
    { code: "en", label: "EN", aria: a11yTexts.switchToEn },
    { code: "pt", label: "PT", aria: a11yTexts.switchToPt },
];
---

<header class="site-header" role="banner">
    <div class="site-header__inner">
        <a href="#inicio" class="brand" aria-label={a11yTexts.homeLink}>
            <svg class="brand__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
                <rect width="40" height="40" rx="9" fill="var(--anil)"></rect>
                <circle cx="27" cy="13" r="6" fill="var(--cempasuchil)"></circle>
                <path d="M12 40 C8 32 24 30 20 24 C17 20 20 17 25 16" fill="none" stroke="var(--cal)" stroke-width="4.5" stroke-linecap="round"></path>
            </svg>
            <span class="brand__name">{texts.title}</span>
        </a>

        <nav class="site-nav" aria-label={a11yTexts.navMain}>
            {links.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>

        <div class="site-header__tools">
            <div class="lang-switch" role="group" aria-label={texts.languages}>
                {
                    langs.map((item) => (
                        <a
                            href={withBase(`${item.code}/`)}
                            class="lang-link"
                            lang={item.code}
                            aria-label={item.aria}
                            aria-current={item.code === lang ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>
            <button id="hamburger-btn" class="menu-btn" aria-label={a11yTexts.openMenu} aria-expanded="false" aria-controls="mobile-menu" data-open-label={a11yTexts.openMenu} data-close-label={a11yTexts.closeMenu}>
                <span class="menu-btn__line"></span>
                <span class="menu-btn__line"></span>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="mobile-menu" hidden>
        <nav aria-label={a11yTexts.navMobile}>
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a href={link.href} class="mobile-link">
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</header>

<style>
    .site-header {
        position: fixed;
        inset: 0 0 auto 0;
        z-index: 50;
        background-color: var(--cal);
        border-bottom: 1px solid var(--line);
    }

    .site-header__inner {
        width: var(--wrap);
        margin-inline: auto;
        height: 4.25rem;
        display: flex;
        align-items: center;
        gap: 2rem;
    }

    .brand {
        display: inline-flex;
        align-items: center;
        gap: 0.7rem;
        text-decoration: none;
        font-weight: 800;
        letter-spacing: -0.015em;
        font-size: 1.05rem;
        white-space: nowrap;
    }

    .brand__mark {
        width: 2.25rem;
        height: 2.25rem;
        flex: none;
    }

    .site-nav {
        display: none;
        gap: clamp(1rem, 2.2vw, 2.25rem);
        margin-left: auto;
        font-weight: 600;
        font-size: 0.98rem;

        a {
            text-decoration: none;
            padding-block: 0.4rem;
            border-bottom: 2px solid transparent;
            transition: border-color 0.2s ease;

            &:hover {
                border-color: var(--cempasuchil);
            }
        }
    }

    .site-header__tools {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-left: auto;
    }

    .lang-switch {
        display: flex;
        border: 1.5px solid var(--anil);
        border-radius: 999px;
        padding: 2px;
    }

    .lang-link {
        display: grid;
        place-items: center;
        min-width: 2.4rem;
        min-height: 2rem;
        padding-inline: 0.5rem;
        border-radius: 999px;
        font-size: 0.82rem;
        font-weight: 750;
        letter-spacing: 0.04em;
        text-decoration: none;
        color: var(--anil);

        &:hover {
            background-color: var(--jacaranda-soft);
        }

        &[aria-current="page"] {
            background-color: var(--anil);
            color: var(--cal);
        }
    }

    .menu-btn {
        display: grid;
        place-content: center;
        gap: 6px;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        background-color: var(--anil);
        cursor: pointer;
    }

    .menu-btn__line {
        display: block;
        width: 1.1rem;
        height: 2px;
        background-color: var(--cal);
        transition: transform 0.25s ease;
    }

    .menu-btn[aria-expanded="true"] .menu-btn__line:nth-child(1) {
        transform: translateY(4px) rotate(45deg);
    }

    .menu-btn[aria-expanded="true"] .menu-btn__line:nth-child(2) {
        transform: translateY(-4px) rotate(-45deg);
    }

    .mobile-menu {
        border-top: 1px solid var(--line);
        background-color: var(--cal);

        ul {
            width: var(--wrap);
            margin-inline: auto;
            padding-block: 0.75rem 1.5rem;
        }

        li + li {
            border-top: 1px solid var(--line);
        }
    }

    .mobile-link {
        display: block;
        padding-block: 0.9rem;
        font-size: 1.35rem;
        font-weight: 750;
        text-decoration: none;
    }

    @media (max-width: 479px) {
        .brand__name {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
            white-space: nowrap;
        }

        .site-header__inner {
            gap: 0.75rem;
        }
    }

    @media (min-width: 1100px) {
        .site-nav {
            display: flex;
        }

        .site-header__tools {
            margin-left: 0;
        }

        .menu-btn,
        .mobile-menu {
            display: none;
        }
    }
</style>

<script is:inline>
    (() => {
        const btn = document.getElementById("hamburger-btn");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;

        const setOpen = (open) => {
            menu.hidden = !open;
            btn.setAttribute("aria-expanded", String(open));
            btn.setAttribute("aria-label", open ? btn.dataset.closeLabel : btn.dataset.openLabel);
            if (open) menu.querySelector("a")?.focus();
        };

        btn.addEventListener("click", () => setOpen(btn.getAttribute("aria-expanded") !== "true"));

        menu.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                setOpen(false);
                btn.focus();
            }
        });

        menu.querySelectorAll(".mobile-link").forEach((link) => link.addEventListener("click", () => setOpen(false)));

        document.querySelectorAll(".lang-link").forEach((link) => {
            link.addEventListener("click", () => {
                const hash = window.location.hash;
                if (hash) link.href = link.getAttribute("href") + hash;
            });
        });
    })();
</script>
