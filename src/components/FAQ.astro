---
import type { FaqTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";
import faqImage from "@/assets/img/FAQ-Ilustracion.svg";
import birdsImage from "@/assets/img/FAQ-aves.svg";

interface Props {
    texts: FaqTexts;
    a11yTexts: A11yTexts;
}

const { texts, a11yTexts } = Astro.props as Props;
---

<div class="relative">
    <Image src={birdsImage} alt={a11yTexts.faqBirdsAlt} class="lg:absolute w-70 top-0 right-0 ml-auto mr-auto md:mr-0" />
    <section id="faq" class="px-6 py-16 max-w-4xl mx-auto relative">
        <h2 class="text-2xl font-bold mb-8 uppercase text-center">{texts.title}</h2>
        <div class="flex flex-col gap-4">
            {
                texts.faqs.map((faq) => (
                    <details name="event-faq" class="bg-gray-50 p-4 border rounded cursor-pointer group">
                        <summary class="font-semibold uppercase flex list-none items-center gap-2 [&::-webkit-details-marker]:hidden">
                            <span class="text-(--bg-primary) transition-transform duration-300 group-open:rotate-360 rotate-270">
                                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 29.3 14.6" fill="currentColor" aria-hidden="true" focusable="false">
                                    <path d="m0 0 14.89 14.6L29.3 0z" />
                                </svg>
                            </span>
                            {faq.title}
                        </summary>
                        <div class="mt-4 text-sm text-gray-600">
                            <div set:html={faq.content} />
                        </div>
                    </details>
                ))
            }
        </div>
        <div class="mt-8">
            <Image src={faqImage} alt={a11yTexts.faqIllustrationAlt} class="w-full md:w-[80%] h-auto ml-auto" />
        </div>
    </section>
</div>
