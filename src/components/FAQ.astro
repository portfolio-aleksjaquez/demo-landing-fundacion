---
import type { FaqTexts, A11yTexts } from "@/i18n/ui";

interface Props {
    texts: FaqTexts;
    a11yTexts: A11yTexts;
}

const { texts } = Astro.props as Props;
const tel = texts.contact.phone.replace(/[^+\d]/g, "");
---

<section id="faq" class="faq" data-trail-stop>
    <div class="wrap faq__grid">
        <div class="faq__aside">
            <h2 class="section-title">{texts.title}</h2>
            <div class="contact">
                <h3 class="contact__title">{texts.contact.title}</h3>
                <p class="contact__text">{texts.contact.text}</p>
                <p class="contact__line"><a href={`tel:${tel}`}>{texts.contact.phone}</a></p>
                <p class="contact__line"><a href={`mailto:${texts.contact.email}`}>{texts.contact.email}</a></p>
            </div>
        </div>

        <div class="faq__list">
            {
                texts.faqs.map((faq) => (
                    <details class="faq-item" name="event-faq">
                        <summary class="faq-item__summary">
                            <span class="faq-item__question">{faq.title}</span>
                            <span class="faq-item__icon" aria-hidden="true" />
                        </summary>
                        <div class="faq-item__answer" set:html={faq.content} />
                    </details>
                ))
            }
        </div>
    </div>
</section>

<style>
    .faq {
        padding-block: var(--section-space);
    }

    .faq__grid {
        display: grid;
        gap: 2.5rem 5rem;
    }

    .faq__aside .section-title {
        max-width: 10ch;
    }

    .contact {
        margin-top: 2rem;
        padding: 1.75rem;
        background-color: var(--anil-ink);
        color: var(--cal);
        border-radius: 0 1.75rem 0 0;
    }

    .contact__title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--cempasuchil);
    }

    .contact__text {
        margin-top: 0.5rem;
        margin-bottom: 1rem;
        color: var(--jacaranda);
    }

    .contact__line {
        font-weight: 700;
        font-size: clamp(0.88rem, 3.6vw, 1rem);
        overflow-wrap: anywhere;

        a {
            text-decoration-color: var(--cempasuchil);
            text-decoration-thickness: 2px;
        }
    }

    .contact__line + .contact__line {
        margin-top: 0.35rem;
    }

    .faq-item {
        border-bottom: 1px solid var(--line);

        &:first-child {
            border-top: 2px solid var(--anil-ink);
        }
    }

    .faq-item__summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        padding-block: 1.2rem;
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }

        &:hover .faq-item__question {
            color: var(--anil);
        }
    }

    .faq-item__question {
        font-size: clamp(1.05rem, 1.6vw, 1.22rem);
        font-weight: 700;
        line-height: 1.3;
    }

    .faq-item__icon {
        position: relative;
        flex: none;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 50%;
        background-color: var(--jacaranda-soft);
        transition:
            transform 0.3s ease,
            background-color 0.2s ease;

        &::before,
        &::after {
            content: "";
            position: absolute;
            inset: 50% auto auto 50%;
            width: 0.9rem;
            height: 2px;
            background-color: var(--anil);
            translate: -50% -50%;
        }

        &::after {
            rotate: 90deg;
        }
    }

    .faq-item[open] .faq-item__icon {
        transform: rotate(45deg);
        background-color: var(--cempasuchil);
    }

    .faq-item__answer {
        padding-bottom: 1.5rem;
        max-width: 62ch;
        font-size: 1.04rem;
        line-height: 1.6;

        :global(ul) {
            display: grid;
            gap: 0.4rem;
            padding-left: 1.1rem;
            list-style: disc;
        }

        :global(li::marker) {
            color: var(--cempasuchil-ink);
        }
    }

    @media (min-width: 1024px) {
        .faq__grid {
            grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
        }

        .faq__aside {
            position: sticky;
            top: 7rem;
            align-self: start;
        }
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        document.querySelectorAll<HTMLDetailsElement>("#faq details").forEach((d) => {
            d.addEventListener("toggle", () => window.dispatchEvent(new Event("trail:refresh")));
        });
    });
</script>
