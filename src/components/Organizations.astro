---
import type { OrganizationsTexts, A11yTexts } from "@/i18n/ui";
import { Image } from "astro:assets";

import IconoFacebook from "@/Icons/IconoFacebook.astro";
import IconoInstagram from "@/Icons/IconoInstagram.astro";
import IconoTwitter from "@/Icons/IconoTwitter.astro";
import IconoLinkedin from "@/Icons/IconoLinkedin.astro";
import IconoYoutube from "@/Icons/IconoYoutube.astro";

interface Props {
    texts: OrganizationsTexts;
    a11yTexts: A11yTexts;
}

const { texts } = Astro.props as Props;
const logos = import.meta.glob<{ default: ImageMetadata }>("/src/assets/logos/org-*.svg");
const total = texts.participants.length;
const filters = Object.entries(texts.regions) as [string, string][];
const socialIcons = [
    { key: "twitter", label: "X (Twitter)", Icon: IconoTwitter },
    { key: "facebook", label: "Facebook", Icon: IconoFacebook },
    { key: "instagram", label: "Instagram", Icon: IconoInstagram },
    { key: "linkedin", label: "LinkedIn", Icon: IconoLinkedin },
    { key: "youtube", label: "YouTube", Icon: IconoYoutube },
] as const;
---

<section id="organizaciones" class="orgs" data-trail-stop>
    <div class="wrap">
        <header class="orgs__head">
            <h2 class="section-title">{texts.title}</h2>
            <p class="orgs__intro">{texts.intro}</p>
        </header>

        <div class="orgs__filters" role="group" aria-label={texts.filtersLabel}>
            {
                filters.map(([key, label]) => (
                    <button type="button" class="chip" data-region={key} aria-pressed={key === "all" ? "true" : "false"}>
                        {label}
                    </button>
                ))
            }
        </div>
        <p class="orgs__status" aria-live="polite" data-template={texts.results} data-total={total}>
            {texts.results.replace("{n}", String(total)).replace("{total}", String(total))}
        </p>

        <ul class="orgs__grid" role="list">
            {
                texts.participants.map((org) => (
                    <li class="org" data-region={org.region}>
                        <h3 class="org__name">
                            {org.url ? (
                                <a href={org.url} aria-label={`${texts.visitSite} ${org.name}`}>
                                    <Image src={logos[`/${org.logo}`]()} alt={org.name} class="org__logo" />
                                </a>
                            ) : (
                                <Image src={logos[`/${org.logo}`]()} alt={org.name} class="org__logo" />
                            )}
                        </h3>
                        <p class="org__country">{org.country}</p>
                        <p class="org__description">{org.description}</p>
                        {org.social && (
                            <ul class="org__social" role="list">
                                {socialIcons.map(({ key, label, Icon }) =>
                                    org.social?.[key] ? (
                                        <li>
                                            <a href={org.social[key]} aria-label={`${label} - ${org.name}`}>
                                                <Icon />
                                            </a>
                                        </li>
                                    ) : null
                                )}
                            </ul>
                        )}
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<style>
    .orgs {
        padding-block: var(--section-space);
        background-color: var(--jacaranda-soft);
    }

    .orgs__head {
        display: grid;
        gap: 1rem;
    }

    .orgs__head .section-title {
        max-width: 12ch;
    }

    .orgs__intro {
        max-width: 42ch;
        font-size: 1.1rem;
    }

    .orgs__filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 2.25rem;
    }

    .chip {
        min-height: 2.6rem;
        padding: 0.45rem 1.1rem 0.35rem;
        border: 1.5px solid var(--anil);
        border-radius: 999px;
        font-weight: 650;
        font-size: 0.98rem;
        color: var(--anil);
        background-color: transparent;
        cursor: pointer;
        transition: background-color 0.2s ease;

        &:hover {
            background-color: var(--jacaranda);
        }

        &[aria-pressed="true"] {
            background-color: var(--anil);
            color: var(--cal);
        }
    }

    .orgs__status {
        margin-top: 1rem;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--anil);
    }

    .orgs__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
        gap: 0 2.5rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
    }

    .org {
        display: flex;
        flex-direction: column;
        padding-block: 1.75rem 2rem;
        border-top: 2px solid var(--anil-ink);

        &[hidden] {
            display: none;
        }
    }

    .org__name {
        margin: 0;
        line-height: 0;

        a {
            display: inline-block;
        }
    }

    .org__logo {
        height: 4.5rem;
        width: auto;
        margin-left: -0.6rem;
        max-width: 100%;
    }

    .org__country {
        margin-top: 1rem;
        font-size: 0.92rem;
        font-weight: 750;
        color: var(--anil);
    }

    .org__description {
        margin-top: 0.4rem;
        font-size: 0.98rem;
        line-height: 1.55;
    }

    .org__social {
        display: flex;
        gap: 0.35rem;
        margin: auto 0 0;
        padding: 1rem 0 0;
        list-style: none;

        a {
            display: grid;
            place-items: center;
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            color: var(--anil);
            transition: background-color 0.2s ease;

            &:hover {
                background-color: var(--jacaranda);
            }
        }

        a :global(svg) {
            width: 1.15rem;
            height: 1.15rem;
        }
    }

    @media (min-width: 900px) {
        .orgs__head {
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: end;
        }
    }
</style>

<script>
    const initOrgFilters = () => {
        const section = document.getElementById("organizaciones");
        if (!section) return;
        const chips = Array.from(section.querySelectorAll<HTMLButtonElement>(".chip"));
        const items = Array.from(section.querySelectorAll<HTMLElement>(".org"));
        const status = section.querySelector<HTMLElement>(".orgs__status");

        chips.forEach((chip) => {
            chip.addEventListener("click", () => {
                const region = chip.dataset.region;
                chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
                let shown = 0;
                items.forEach((item) => {
                    const visible = region === "all" || item.dataset.region === region;
                    item.hidden = !visible;
                    if (visible) shown++;
                });
                if (status) {
                    status.textContent = (status.dataset.template ?? "").replace("{n}", String(shown)).replace("{total}", status.dataset.total ?? "");
                }
                window.dispatchEvent(new Event("trail:refresh"));
            });
        });
    };

    document.addEventListener("astro:page-load", initOrgFilters);
</script>
